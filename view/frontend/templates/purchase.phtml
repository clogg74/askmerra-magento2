<?php
/**
 * The order just placed, reported to AskMerra by js/storefront.js once the shopper's analytics
 * consent allows it (see AskMerra\Connector\Block\Purchase).
 *
 * @var \AskMerra\Connector\Block\Purchase $block
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
 */
$purchase = $block->getPurchase();
?>
<?php if ($purchase !== null): ?>
    <?= /* @noEscape */ $secureRenderer->renderTag(
        'script',
        [],
        'window.AskMerraMagentoPurchase = ' . $block->encodeJson($purchase) . ';',
        false
    ) ?>
<?php endif; ?>
