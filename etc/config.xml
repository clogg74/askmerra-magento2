<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <askmerra>
            <general>
                <enabled>0</enabled>
                <locale>auto</locale>
            </general>
            <catalog>
                <sync_method>push</sync_method>
                <product_identifier>id</product_identifier>
                <product_types>simple,configurable,virtual,bundle,grouped,downloadable</product_types>
                <visibility>4,2,3</visibility>
                <include_out_of_stock>1</include_out_of_stock>
                <description_source>description</description_source>
                <include_variant_options>1</include_variant_options>
                <image_count>4</image_count>
                <include_stock_qty>0</include_stock_qty>
            </catalog>
            <push>
                <batch_size>200</batch_size>
                <full_sync_frequency>weekly</full_sync_frequency>
                <full_sync_time>03,15,00</full_sync_time>
            </push>
            <feed>
                <format>json</format>
                <frequency>60</frequency>
            </feed>
            <widget>
                <enabled>1</enabled>
                <script_url>https://cdn.askmerra.com/v1/widget.js</script_url>
                <open_on_load>0</open_on_load>
                <product_context>1</product_context>
                <add_to_cart>1</add_to_cart>
                <after_add_to_cart>stay</after_add_to_cart>
                <track_purchases>1</track_purchases>
                <consent_mode>auto</consent_mode>
                <show_on_checkout>0</show_on_checkout>
            </widget>
            <advanced>
                <api_url>https://api.askmerra.com</api_url>
                <timeout>30</timeout>
                <debug>0</debug>
            </advanced>
        </askmerra>
        <crontab>
            <default>
                <jobs>
                    <askmerra_daily>
                        <schedule>
                            <cron_expr>15 3 * * *</cron_expr>
                        </schedule>
                    </askmerra_daily>
                    <askmerra_feed_generate>
                        <schedule>
                            <cron_expr>5 * * * *</cron_expr>
                        </schedule>
                    </askmerra_feed_generate>
                </jobs>
            </default>
        </crontab>
    </default>
</config>
