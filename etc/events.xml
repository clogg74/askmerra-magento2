<?xml version="1.0"?>
<!-- Only used while the AskMerra indexer is on "Update on Save"; see Observer\ProductChanged. -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="catalog_product_save_after">
        <observer name="askmerra_product_changed" instance="AskMerra\Connector\Observer\ProductChanged"/>
    </event>
    <event name="catalog_product_delete_after_done">
        <observer name="askmerra_product_changed" instance="AskMerra\Connector\Observer\ProductChanged"/>
    </event>
    <event name="catalog_product_attribute_update_before">
        <observer name="askmerra_product_changed" instance="AskMerra\Connector\Observer\ProductChanged"/>
    </event>
    <event name="cataloginventory_stock_item_save_after">
        <observer name="askmerra_product_changed" instance="AskMerra\Connector\Observer\ProductChanged"/>
    </event>
</config>
