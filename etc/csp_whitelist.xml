<?xml version="1.0"?>
<!-- The AskMerra widget script and the API it talks to. Custom hosts: Model\Csp\PolicyCollector. -->
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="askmerra-widget" type="host">https://cdn.askmerra.com</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="askmerra-api" type="host">https://api.askmerra.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
